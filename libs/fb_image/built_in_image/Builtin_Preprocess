# Built-in 전처리 공용 베이스 이미지
#
# 목적: fb_preprocessing 빌트인 TFS 잡(prepro pod)이 사용하는 기본 실행 이미지.
#   기존 jbi_ubuntu(jupyter/vscode/node 포함 무거운 워크스페이스 이미지)와 분리한 lean 이미지.
#   docker.io/acrylaaai 에 게시(신규 클러스터가 pull 가능; 사내 jfb/ 레지스트리 미가용 대응).
#
# 포함 전처리기 의존성:
#   - SDS_LLAVA_CONVERT : 표준 라이브러리만 (csv/json)
#   - FORMAT_CONVERT    : pandas + pyarrow(Parquet)
#   - IMAGE_AUGMENT     : Pillow
#   - (향후 전처리기 확장 대비 numpy 포함)
#
# 실행 규약: 스케줄러가 이 이미지 pod 안에서 `python3 -u /built_in/<script> ...` 실행.
#   /built_in 은 NFS bin PVC(preprocessing/)가 RO 마운트.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip ca-certificates tzdata \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && ln -fs /usr/share/zoneinfo/$TZ /etc/localtime \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 전처리 공용 파이썬 의존성 (버전 고정)
RUN pip3 install --no-cache-dir \
        pandas==2.2.2 \
        pyarrow==16.1.0 \
        pillow==10.3.0 \
        numpy==1.26.4

WORKDIR /built_in
CMD ["/bin/bash"]
