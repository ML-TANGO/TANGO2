[Unit]
Description=TANGO2 AGX continuous LLM requests for Grafana
After=network-online.target tango2-llm-exporter.service
Wants=network-online.target tango2-llm-exporter.service

[Service]
User=rtst
WorkingDirectory=/home/rtst/tango2-llm-stages
ExecStart=/usr/bin/python3 /home/rtst/tango2-llm-stages/source/run_continuous.py
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
CPUAffinity=0 1 2 3 5 6 7 8 9 10 11
Restart=always
RestartSec=15
KillMode=control-group
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
